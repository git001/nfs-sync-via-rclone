#!/bin/sh
# Periodic trigger for nfs-sync via busybox crond.
# Installed to /etc/periodic/15min/nfs-sync — fires every 15 minutes.
#
# Move to /etc/periodic/hourly/ or /etc/periodic/daily/ to slow down,
# or drop a custom /etc/crontabs/nfs-sync entry for finer control.

# Run as the nfs-sync user (crond runs scripts as root by default).
exec su -s /bin/sh nfs-sync -c '/usr/bin/nfs-sync'
