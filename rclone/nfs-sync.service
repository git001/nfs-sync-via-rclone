[Unit]
Description=NFS → Azure Blob reconcile sync
Documentation=https://rclone.org/azureblob/
After=network-online.target remote-fs.target
Wants=network-online.target remote-fs.target
# Hard requirement: the NFS mount must be present.
RequiresMountsFor=/mnt/nfs/source

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/nfs-sync
ExecStart=/usr/bin/nfs-sync
# Don't fail the unit if flock contention triggers exit 2.
SuccessExitStatus=0 2
OnFailure=nfs-sync-failure.service

# Resource bounding — adjust to host capacity.
# rclone with 32 transfers / 32 checkers easily uses several CPU cores
# and many GB RSS on 1M+ file trees.
MemoryMax=8G
CPUWeight=80
IOWeight=80

# Security hardening (paranoid defaults).
User=nfs-sync
Group=nfs-sync
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadOnlyPaths=/mnt/nfs/source
ReadWritePaths=/var/log/nfs-sync /var/run

[Install]
WantedBy=multi-user.target
